# Backup job settings. Copy to infra/backup/.env. NEVER commit .env.
# This file holds ONLY the backups token (least privilege): no private-bucket token, no age identity.
R2_ACCOUNT_ID=
R2_BACKUP_BUCKET=focuslearn-backups
R2_BACKUP_KEY_ID=
R2_BACKUP_SECRET=

# age PUBLIC key (starts with age1). Generate the pair on a trusted machine, NOT on this server:
#   age-keygen -o focuslearn-backup-identity.txt     (the file holds the SECRET identity: store it offline, 3 copies)
# The public key is printed by age-keygen (or: age-keygen -y identity.txt). Only the public key goes here.
BACKUP_AGE_RECIPIENT=

# Database role used for pg_dump inside the db container (default postgres)
PG_DUMP_USER=postgres
# Refuse to upload a dump smaller than this many bytes (guards against an empty dump)
MIN_DUMP_BYTES=10240

# Optional dead-man's-switch for backups (a second check in the same monitor, period 1 day, grace 6 hours). A SECRET. Must be https.
# backup.sh pings it after every success and pings <URL>/fail after a failure.
BACKUP_PING_URL=
