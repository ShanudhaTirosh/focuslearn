# R2 settings for the spike and (later) server-side functions. Copy to infra/cloudflare/.env. NEVER commit .env.
# Server-side only. These values must never appear in Flutter, admin frontend code, or git history.
R2_ACCOUNT_ID=

R2_PRIVATE_BUCKET=focuslearn-private
R2_PRIVATE_KEY_ID=
R2_PRIVATE_SECRET=

R2_BACKUP_BUCKET=focuslearn-backups
R2_BACKUP_KEY_ID=
R2_BACKUP_SECRET=

# Origin used for the CORS preflight test (must be listed in r2-cors.json)
SPIKE_ALLOWED_ORIGIN=https://eduapp-admin.shanutechx.com
