# FocusLearn overlay inputs. NOT the upstream Supabase .env (that one is generated into infra/docker/stack/.env).
# Copy to infra/docker/.env and edit. Never commit infra/docker/.env.

# local  = http://localhost:8000, for first boot on this machine
# public = https://$API_HOST behind Cloudflare Tunnel (step 0.5 onward)
FOCUSLEARN_MODE=local

API_HOST=eduapp-api.shanutechx.com
STUDIO_HOST=eduapp-studio.shanutechx.com
ADMIN_HOST=eduapp-admin.shanutechx.com
APP_HOST=eduapp-app.shanutechx.com
FILES_HOST=eduapp-files.shanutechx.com

# SMTP (step 0.7, docs/setup/04-email.md). Leave SMTP_HOST empty to skip.
# Provisional provider: Brevo (host smtp-relay.brevo.com, port 587 with STARTTLS). Use the SMTP key as SMTP_PASS, NOT the API key.
# SMTP_USER is the "SMTP login" shown on the provider's SMTP page (it may end in @smtp-brevo.com).
# SMTP_ADMIN_EMAIL must be an address on a domain you have authenticated with the provider.
SMTP_ADMIN_EMAIL=no-reply@eduapp.shanutechx.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=FocusLearn

# --- Cloudflare Tunnel (public mode only; see docs/setup/02-cloudflare-edge.md) ---
# Created with: cloudflared tunnel create focuslearn
TUNNEL_UUID=
# Path to the credentials JSON that `cloudflared tunnel create` wrote (e.g. ~/.cloudflared/<UUID>.json)
CLOUDFLARED_CREDENTIALS_FILE=

# --- Turnstile (leave empty until the widget exists; never enable captcha with a wrong secret) ---
TURNSTILE_SECRET=

# --- Monitoring (docs/setup/06-monitoring.md) ---
# Dead-man's-switch ping URL, e.g. from Healthchecks.io (a SECRET: anyone with it can send pings). Must be https.
HEARTBEAT_URL=
