  "pairs": [
    {"fg": "text", "bg": "background", "min": 4.5, "use": "body text on the page"},
    {"fg": "text", "bg": "surface", "min": 4.5, "use": "body text on cards"},
    {"fg": "text", "bg": "surfaceVariant", "min": 4.5, "use": "body text on raised or selected areas"},
    {"fg": "textMuted", "bg": "background", "min": 4.5, "use": "secondary text on the page"},
    {"fg": "textMuted", "bg": "surface", "min": 4.5, "use": "secondary text on cards"},
    {"fg": "onPrimary", "bg": "primary", "min": 4.5, "use": "label on a primary button"},
    {"fg": "primary", "bg": "background", "min": 4.5, "use": "links and primary text on the page"},
    {"fg": "primary", "bg": "surface", "min": 4.5, "use": "links on cards"},
    {"fg": "onSecondary", "bg": "secondary", "min": 4.5, "use": "label on a secondary fill (dark text: white fails on the light secondary)"},
    {"fg": "secondary", "bg": "background", "min": 3.0, "use": "non-text: icons, chart series, focus indicators"},
    {"fg": "borderStrong", "bg": "background", "min": 3.0, "use": "non-text: input outlines and control boundaries (WCAG 1.4.11)"},
    {"fg": "borderStrong", "bg": "surface", "min": 3.0, "use": "non-text: input outlines on cards"},
    {"fg": "onSuccess", "bg": "success", "min": 4.5, "use": "label on a success fill"},
    {"fg": "successText", "bg": "background", "min": 4.5, "use": "success message text on the page"},
    {"fg": "successText", "bg": "surface", "min": 4.5, "use": "success message text on cards"},
    {"fg": "success", "bg": "background", "min": 3.0, "use": "non-text: success icons"},
    {"fg": "onWarning", "bg": "warning", "min": 4.5, "use": "label on a warning fill"},
    {"fg": "warningText", "bg": "background", "min": 4.5, "use": "warning message text on the page"},
    {"fg": "warningText", "bg": "surface", "min": 4.5, "use": "warning message text on cards"},
    {"fg": "onError", "bg": "error", "min": 4.5, "use": "label on an error fill"},
    {"fg": "errorText", "bg": "background", "min": 4.5, "use": "error message text on the page"},
    {"fg": "errorText", "bg": "surface", "min": 4.5, "use": "error message text on cards"},
    {"fg": "error", "bg": "background", "min": 3.0, "use": "non-text: error icons and field outlines"},
    {"fg": "onInfo", "bg": "info", "min": 4.5, "use": "label on an info fill"},
    {"fg": "infoText", "bg": "background", "min": 4.5, "use": "info message text on the page"},
    {"fg": "infoText", "bg": "surface", "min": 4.5, "use": "info message text on cards"}
  ],
  "knownFailures": [
    {"theme": "light", "fg": "warning", "bg": "background", "min": 3.0, "why": "amber on white is below 3:1: never use the warning colour as a lone icon or line on a light background. Use it only as a fill with onWarning text, or use warningText."},
    {"theme": "light", "fg": "onPrimary", "bg": "secondary", "min": 4.5, "why": "white text on the light secondary blue is below 4.5:1: use onSecondary (dark text)."},
    {"theme": "light", "fg": "onPrimary", "bg": "success", "min": 4.5, "why": "white text on the success green is below 4.5:1: use onSuccess (dark text)."},
    {"theme": "light", "fg": "border", "bg": "background", "min": 3.0, "why": "the decorative border is deliberately faint: it must never be the only thing that shows where an input is (use borderStrong)."}
